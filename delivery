        cout << "\n== NEGOCIOS ==\n";
        for (int i = 0; i < sistema_.cantNegocios(); ++i) { sistema_.negocio(i).mostrar(); cout << "\n"; }
        cout << "== CLIENTES ==\n";
        for (int i = 0; i < sistema_.cantClientes(); ++i) { sistema_.cliente(i).mostrar(); cout << "\n"; }
        cout << "== MENSAJEROS ==\n";
        for (int i = 0; i < sistema_.cantMensajeros(); ++i) { sistema_.mensajero(i).mostrar(); cout << "\n"; }
    }

    void verMenu() {
        int id = leerInt("Id del negocio: ");
        Negocio* n = sistema_.buscarNegocio(id);
        if (n) n->mostrarMenu();
        else cout << "Negocio no existe.\n";
    }

    void crearOrden() {
        int cid = leerInt("Id del cliente: ");
        int nid = leerInt("Id del negocio: ");
        Negocio* n = sistema_.buscarNegocio(nid);
        if (!n || !sistema_.buscarCliente(cid)) { cout << "Cliente o negocio no existe.\n"; return; }

        n->mostrarMenu();
        LineaOrden carrito[MAX_LINEAS];
        int nCarrito = 0;
        cout << "Agrega items al carrito (id 0 para terminar):\n";
        while (nCarrito < MAX_LINEAS) {
            int iid = leerInt("  Id del item: ");
            if (iid == 0) break;
            const ItemMenu* it = n->buscarItem(iid);
            if (!it) { cout << "  Item no existe.\n"; continue; }
            int cant = leerInt("  Cantidad: ");
            if (cant <= 0) { cout << "  Cantidad invalida.\n"; continue; }
            carrito[nCarrito].itemId = it->id;
            carrito[nCarrito].nombre = it->nombre;
            carrito[nCarrito].cantidad = cant;
            carrito[nCarrito].precio = it->precio;
            ++nCarrito;
        }
        if (nCarrito == MAX_LINEAS) cout << "Carrito lleno (maximo " << MAX_LINEAS << " lineas).\n";

        string error;
        Orden* o = sistema_.crearOrden(cid, nid, carrito, nCarrito, error);
        if (!o) { cout << "No se pudo crear la orden: " << error << "\n"; return; }

        Mensajero* m = sistema_.buscarMensajero(o->mensajeroId());
        cout << "\nOrden creada. Mensajero asignado: " << m->nombre() << " (#" << m->id() << ")\n";
        o->mostrar();
    }

    void avanzarEstado() {
        string msg;
        sistema_.avanzarOrden(leerInt("Id de la orden: "), msg);
        cout << msg << "\n";
    }

    void listarOrdenes() const {
        if (sistema_.cantOrdenes() == 0) cout << "No hay ordenes.\n";
        for (int i = 0; i < sistema_.cantOrdenes(); ++i) sistema_.orden(i).mostrar();
    }

    void consultarDistancia() {
        Negocio* n = sistema_.buscarNegocio(leerInt("Id del negocio: "));
        Cliente* c = sistema_.buscarCliente(leerInt("Id del cliente: "));
        if (!n || !c) { cout << "Negocio o cliente no existe.\n"; return; }
        double km = n->ubicacion().distanciaKm(c->ubicacion());
        cout << fixed << setprecision(2) << "Distancia: " << km << " km | Tarifa: S/ "
             << TarifaPorKm().calcular(km) << "\n";
    }

public:
    void ejecutar() {
        if (repo_.leer(sistema_)) cout << "Datos cargados desde archivo.\n";
        while (true) {
            cout << "\n===== DELIVERY SIMULADO =====\n"
                    "1. Registrar negocio (con menu)\n"
                    "2. Registrar cliente\n"
                    "3. Registrar mensajero\n"
                    "4. Listar entidades\n"
                    "5. Ver menu de un negocio\n"
                    "6. Crear orden\n"
                    "7. Avanzar estado de una orden\n"
                    "8. Listar ordenes\n"
                    "9. Consultar distancia y tarifa negocio-cliente\n"
                    "10. Guardar en archivo\n"
                    "11. Leer desde archivo\n"
                    "0. Salir (guarda automaticamente)\n";
            switch (leerInt("Opcion: ")) {
                case 1: registrarNegocio(); break;
                case 2: registrarCliente(); break;
                case 3: registrarMensajero(); break;
                case 4: listarEntidades(); break;
                case 5: verMenu(); break;
                case 6: crearOrden(); break;
                case 7: avanzarEstado(); break;
                case 8: listarOrdenes(); break;
                case 9: consultarDistancia(); break;
                case 10: cout << (repo_.guardar(sistema_) ? "Guardado.\n" : "Error al guardar.\n"); break;
                case 11: cout << (repo_.leer(sistema_) ? "Datos leidos.\n" : "No hay archivos.\n"); break;
                case 0:
                    repo_.guardar(sistema_);
                    cout << "Datos guardados. Hasta luego.\n";
                    return;
                default: cout << "Opcion invalida.\n";
            }
        }
    }
};

int main() {
    App app;
    app.ejecutar();
    return 0;
}
