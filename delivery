const int MAX_CAMPOS = 16;
const double PI = 3.1416;

static int dividir(const string& s, char d, string partes[], int maxPartes) {
    int n = 0;
    string actual;
    for (size_t i = 0; i <= s.size(); ++i) {
        if (i == s.size() || s[i] == d) {
            if (n < maxPartes) partes[n++] = actual;
            actual = "";
        } else {
            actual += s[i];
        }
    }
    return n;
}

static string limpiar(string s) {
    for (size_t i = 0; i < s.size(); ++i)
        if (s[i] == '|' || s[i] == ';' || s[i] == ':') s[i] = ' ';
    return s;
}

static string fmt(double v, int dec) {
    char buf[64];
    snprintf(buf, sizeof(buf), "%.*f", dec, v);
    return string(buf);
}

template <class T>
static int siguienteId(const T arr[], int n) {
    int m = 0;
    for (int i = 0; i < n; ++i)
        if (arr[i].id() > m) m = arr[i].id();
    return m + 1;
}

template <class T>
static T* buscar(T arr[], int n, int id) {
    for (int i = 0; i < n; ++i)
        if (arr[i].id() == id) return &arr[i];
    return nullptr;
}

struct Ubicacion {
    double lat = 0.0;
    double lon = 0.0;

    double distanciaKm(const Ubicacion& o) const {
        const double R = 6371.0;
        const double rad = PI / 180.0;
        double dLat = (o.lat - lat) * rad;
        double dLon = (o.lon - lon) * rad;
        double a = sin(dLat / 2) * sin(dLat / 2) +
                   cos(lat * rad) * cos(o.lat * rad) * sin(dLon / 2) * sin(dLon / 2);
        return 2 * R * atan2(sqrt(a), sqrt(1 - a));
    }
};

class Entidad {
protected:
    int id_;
    string nombre_;
    Ubicacion ubi_;

public:
    Entidad() : id_(0) {}
    Entidad(int id, const string& nombre, Ubicacion ubi)
        : id_(id), nombre_(limpiar(nombre)), ubi_(ubi) {}
    virtual ~Entidad() = default;

    int id() const { return id_; }
    const string& nombre() const { return nombre_; }
    const Ubicacion& ubicacion() const { return ubi_; }

    virtual string tipo() const = 0;
    virtual string serializar() const = 0;
    virtual void mostrar() const {
        cout << "[" << tipo() << " #" << id_ << "] " << nombre_ << fixed << setprecision(5)
             << "  GPS(" << ubi_.lat << ", " << ubi_.lon << ")";
    }

protected:
    string base() const {
        return to_string(id_) + "|" + nombre_ + "|" + fmt(ubi_.lat, 6) + "|" + fmt(ubi_.lon, 6);
    }
};

struct ItemMenu {
    int id = 0;
    string nombre;
    double precio = 0.0;
};

class Negocio : public Entidad {
    ItemMenu menu_[MAX_ITEMS];
    int nItems_;

public:
    Negocio() : Entidad(), nItems_(0) {}
    Negocio(int id, const string& nombre, Ubicacion u) : Entidad(id, nombre, u), nItems_(0) {}

    string tipo() const override { return "NEGOCIO"; }

    bool agregarItem(const string& nombre, double precio) {
        int nuevoId = 1;
        for (int i = 0; i < nItems_; ++i)
            if (menu_[i].id >= nuevoId) nuevoId = menu_[i].id + 1;
        return agregarItemConId(nuevoId, nombre, precio);
    }
    bool agregarItemConId(int id, const string& nombre, double precio) {
        if (nItems_ >= MAX_ITEMS) return false;  // menu lleno
        menu_[nItems_].id = id;
        menu_[nItems_].nombre = limpiar(nombre);
        menu_[nItems_].precio = precio;
        ++nItems_;
        return true;
    }
    const ItemMenu* buscarItem(int id) const {
        for (int i = 0; i < nItems_; ++i)
            if (menu_[i].id == id) return &menu_[i];
        return nullptr;
    }
    int cantidadItems() const { return nItems_; }

    void mostrarMenu() const {
        cout << "--- Menu de " << nombre_ << " ---\n";
        if (nItems_ == 0) cout << "(sin items)\n";
        for (int i = 0; i < nItems_; ++i)
            cout << "  " << menu_[i].id << ") " << left << setw(25) << menu_[i].nombre << right
                 << "S/ " << fixed << setprecision(2) << menu_[i].precio << "\n";
    }

    string serializar() const override {
        string s = "NEGOCIO|" + base() + "\n";
        for (int i = 0; i < nItems_; ++i)
            s += "ITEM|" + to_string(id_) + "|" + to_string(menu_[i].id) + "|" +
                 menu_[i].nombre + "|" + fmt(menu_[i].precio, 2) + "\n";
        return s;
    }
};

class Cliente : public Entidad {
public:
    Cliente() : Entidad() {}
    Cliente(int id, const string& nombre, Ubicacion u) : Entidad(id, nombre, u) {}
    string tipo() const override { return "CLIENTE"; }
    string serializar() const override { return "CLIENTE|" + base() + "\n"; }
};

struct Vehiculo {
    string tipo;   // moto, bicicleta, auto...
    string placa;
};

class Mensajero : public Entidad {
    Vehiculo vehiculo_;
    bool disponible_;

public:
    Mensajero() : Entidad(), disponible_(true) {}
    Mensajero(int id, const string& nombre, Ubicacion u, Vehiculo v, bool disp = true)
        : Entidad(id, nombre, u), vehiculo_{limpiar(v.tipo), limpiar(v.placa)},
          disponible_(disp) {}

    string tipo() const override { return "MENSAJERO"; }
    bool disponible() const { return disponible_; }
    void setDisponible(bool d) { disponible_ = d; }
    void setUbicacion(const Ubicacion& u) { ubi_ = u; }
    const Vehiculo& vehiculo() const { return vehiculo_; }

    void mostrar() const override {
        Entidad::mostrar();
        cout << "  " << vehiculo_.tipo << " [" << vehiculo_.placa << "]  "
             << (disponible_ ? "DISPONIBLE" : "OCUPADO");
    }
    string serializar() const override {
        return "MENSAJERO|" + base() + "|" + vehiculo_.tipo + "|" + vehiculo_.placa + "|" +
               (disponible_ ? "1" : "0") + "\n";
    }
};

class CalculadoraTarifa {
public:
    virtual ~CalculadoraTarifa() = default;
    virtual double calcular(double km) const = 0;
};

class TarifaPorKm : public CalculadoraTarifa {
    double base_, porKm_, minima_;

public:
    TarifaPorKm(double base = 3.0, double porKm = 1.5, double minima = 4.0)
        : base_(base), porKm_(porKm), minima_(minima) {}
    double calcular(double km) const override {
        double t = base_ + porKm_ * km;
        return (t > minima_) ? t : minima_;
    }
};

enum class EstadoOrden { Pendiente, Preparando, EnCamino, Entregado };

static string aTexto(EstadoOrden e) {
    switch (e) {
        case EstadoOrden::Pendiente:  return "Pendiente";
        case EstadoOrden::Preparando: return "Preparando";
        case EstadoOrden::EnCamino:   return "En camino";
        case EstadoOrden::Entregado:  return "Entregado";
    }
    return "?";
}

struct LineaOrden {
    int itemId = 0;
    string nombre;
    int cantidad = 0;
    double precio = 0.0;
};

class Orden {
    int id_, clienteId_, negocioId_, mensajeroId_;
    LineaOrden lineas_[MAX_LINEAS];
    int nLineas_;
    double distanciaKm_, tarifa_;
    EstadoOrden estado_;

public:
    Orden()
        : id_(0), clienteId_(0), negocioId_(0), mensajeroId_(0), nLineas_(0),
          distanciaKm_(0), tarifa_(0), estado_(EstadoOrden::Pendiente) {}

    Orden(int id, int cli, int neg, int men, const LineaOrden lineas[], int n, double km,
          double tarifa, EstadoOrden est = EstadoOrden::Pendiente)
        : id_(id), clienteId_(cli), negocioId_(neg), mensajeroId_(men), nLineas_(0),
          distanciaKm_(km), tarifa_(tarifa), estado_(est) {
        for (int i = 0; i < n && i < MAX_LINEAS; ++i) lineas_[nLineas_++] = lineas[i];
    }

    int id() const { return id_; }
    int clienteId() const { return clienteId_; }
    int negocioId() const { return negocioId_; }
    int mensajeroId() const { return mensajeroId_; }
    EstadoOrden estado() const { return estado_; }
    double distanciaKm() const { return distanciaKm_; }
    double tarifa() const { return tarifa_; }

    double subtotal() const {
        double s = 0;
        for (int i = 0; i < nLineas_; ++i) s += lineas_[i].cantidad * lineas_[i].precio;
        return s;
    }
    double total() const { return subtotal() + tarifa_; }

    bool avanzar() {
        if (estado_ == EstadoOrden::Entregado) return false;
        estado_ = static_cast<EstadoOrden>(static_cast<int>(estado_) + 1);
        return true;
    }

    void mostrar() const {
        cout << "Orden #" << id_ << " | cliente " << clienteId_ << " | negocio " << negocioId_
             << " | mensajero " << mensajeroId_ << " | " << aTexto(estado_) << "\n";
        for (int i = 0; i < nLineas_; ++i)
            cout << "    " << lineas_[i].cantidad << " x " << lineas_[i].nombre << " (S/ "
                 << fixed << setprecision(2) << lineas_[i].precio << ")\n";
        cout << fixed << setprecision(2) << "    Distancia: " << distanciaKm_
             << " km | Subtotal: S/ " << subtotal() << " | Envio: S/ " << tarifa_
             << " | TOTAL: S/ " << total() << "\n";
    }

    string serializar() const {
        string s = "ORDEN|" + to_string(id_) + "|" + to_string(clienteId_) + "|" +
                   to_string(negocioId_) + "|" + to_string(mensajeroId_) + "|" +
                   fmt(distanciaKm_, 4) + "|" + fmt(tarifa_, 2) + "|" +
                   to_string(static_cast<int>(estado_)) + "|";
        for (int i = 0; i < nLineas_; ++i) {
            if (i > 0) s += ";";
            s += to_string(lineas_[i].itemId) + ":" + to_string(lineas_[i].cantidad) + ":" +
                 fmt(lineas_[i].precio, 2) + ":" + lineas_[i].nombre;
        }
        return s + "\n";
    }
};

class SistemaDelivery {
    Negocio negocios_[MAX_NEGOCIOS];
    Cliente clientes_[MAX_CLIENTES];
    Mensajero mensajeros_[MAX_MENSAJEROS];
    Orden ordenes_[MAX_ORDENES];
    int nNegocios_, nClientes_, nMensajeros_, nOrdenes_;
    TarifaPorKm tarifa_;

public:
    SistemaDelivery() : nNegocios_(0), nClientes_(0), nMensajeros_(0), nOrdenes_(0) {}

    Negocio* registrarNegocio(const string& n, Ubicacion u) {
        if (nNegocios_ >= MAX_NEGOCIOS) return nullptr;
        negocios_[nNegocios_] = Negocio(siguienteId(negocios_, nNegocios_), n, u);
        return &negocios_[nNegocios_++];
    }
    Cliente* registrarCliente(const string& n, Ubicacion u) {
        if (nClientes_ >= MAX_CLIENTES) return nullptr;
        clientes_[nClientes_] = Cliente(siguienteId(clientes_, nClientes_), n, u);
        return &clientes_[nClientes_++];
    }
    Mensajero* registrarMensajero(const string& n, Ubicacion u, Vehiculo v) {
        if (nMensajeros_ >= MAX_MENSAJEROS) return nullptr;
        mensajeros_[nMensajeros_] = Mensajero(siguienteId(mensajeros_, nMensajeros_), n, u, v);
        return &mensajeros_[nMensajeros_++];
    }

    bool agregar(const Negocio& n) {
        if (nNegocios_ >= MAX_NEGOCIOS) return false;
        negocios_[nNegocios_++] = n;
        return true;
    }
    bool agregar(const Cliente& c) {
        if (nClientes_ >= MAX_CLIENTES) return false;
        clientes_[nClientes_++] = c;
        return true;
    }
    bool agregar(const Mensajero& m) {
        if (nMensajeros_ >= MAX_MENSAJEROS) return false;
        mensajeros_[nMensajeros_++] = m;
        return true;
    }
    bool agregar(const Orden& o) {
        if (nOrdenes_ >= MAX_ORDENES) return false;
        ordenes_[nOrdenes_++] = o;
        return true;
    }
    void limpiarTodo() { nNegocios_ = nClientes_ = nMensajeros_ = nOrdenes_ = 0; }

    int cantNegocios() const { return nNegocios_; }
    int cantClientes() const { return nClientes_; }
    int cantMensajeros() const { return nMensajeros_; }
    int cantOrdenes() const { return nOrdenes_; }
    const Negocio& negocio(int i) const { return negocios_[i]; }
    const Cliente& cliente(int i) const { return clientes_[i]; }
    const Mensajero& mensajero(int i) const { return mensajeros_[i]; }
    const Orden& orden(int i) const { return ordenes_[i]; }

    Negocio* buscarNegocio(int id) { return buscar(negocios_, nNegocios_, id); }
    Cliente* buscarCliente(int id) { return buscar(clientes_, nClientes_, id); }
    Mensajero* buscarMensajero(int id) { return buscar(mensajeros_, nMensajeros_, id); }
    Orden* buscarOrden(int id) { return buscar(ordenes_, nOrdenes_, id); }

    Mensajero* mensajeroMasCercano(const Ubicacion& destino) {
        Mensajero* mejor = nullptr;
        double mejorKm = 1e18;
        for (int i = 0; i < nMensajeros_; ++i) {
            if (!mensajeros_[i].disponible()) continue;
            double d = mensajeros_[i].ubicacion().distanciaKm(destino);
            if (d < mejorKm) { mejorKm = d; mejor = &mensajeros_[i]; }
        }
        return mejor;
    }

    Orden* crearOrden(int clienteId, int negocioId, const LineaOrden carrito[], int nLineas,
                      string& error) {
        Cliente* c = buscarCliente(clienteId);
        Negocio* n = buscarNegocio(negocioId);
        if (!c) { error = "Cliente no existe."; return nullptr; }
        if (!n) { error = "Negocio no existe."; return nullptr; }
        if (nLineas <= 0) { error = "El carrito esta vacio."; return nullptr; }
        if (nOrdenes_ >= MAX_ORDENES) { error = "Se alcanzo el maximo de ordenes."; return nullptr; }

        Mensajero* m = mensajeroMasCercano(n->ubicacion());
        if (!m) { error = "No hay mensajeros disponibles."; return nullptr; }

        double km = n->ubicacion().distanciaKm(c->ubicacion());
        double tarifa = tarifa_.calcular(km);

        m->setDisponible(false);
        ordenes_[nOrdenes_] = Orden(siguienteId(ordenes_, nOrdenes_), clienteId, negocioId,
                                    m->id(), carrito, nLineas, km, tarifa);
        return &ordenes_[nOrdenes_++];
    }

    bool avanzarOrden(int id, string& msg) {
        Orden* o = buscarOrden(id);
        if (!o) { msg = "Orden no existe."; return false; }
        if (!o->avanzar()) { msg = "La orden ya fue entregada."; return false; }
        if (o->estado() == EstadoOrden::Entregado) {
            Mensajero* m = buscarMensajero(o->mensajeroId());
            Cliente* c = buscarCliente(o->clienteId());
            if (m) {
                if (c) m->setUbicacion(c->ubicacion());
                m->setDisponible(true);
            }
        }
        msg = "Orden #" + to_string(id) + " ahora esta: " + aTexto(o->estado());
        return true;
    }
};

class RepositorioArchivo {
    string archEntidades_, archOrdenes_;

public:
    RepositorioArchivo(string e = "entidades.txt", string o = "ordenes.txt")
        : archEntidades_(e), archOrdenes_(o) {}

    bool guardar(const SistemaDelivery& s) const {
        ofstream fe(archEntidades_.c_str());
        ofstream fo(archOrdenes_.c_str());
        if (!fe || !fo) return false;
        for (int i = 0; i < s.cantNegocios(); ++i) fe << s.negocio(i).serializar();
        for (int i = 0; i < s.cantClientes(); ++i) fe << s.cliente(i).serializar();
        for (int i = 0; i < s.cantMensajeros(); ++i) fe << s.mensajero(i).serializar();
        for (int i = 0; i < s.cantOrdenes(); ++i) fo << s.orden(i).serializar();
        return true;
    }

    bool leer(SistemaDelivery& s) const {
        ifstream fe(archEntidades_.c_str());
        ifstream fo(archOrdenes_.c_str());
        if (!fe && !fo) return false;
        s.limpiarTodo();

        string linea;
        string p[MAX_CAMPOS];
        while (getline(fe, linea)) {
            int n = dividir(linea, '|', p, MAX_CAMPOS);
            if (n == 0) continue;
            try {
                if (p[0] == "NEGOCIO" && n >= 5) {
                    s.agregar(Negocio(stoi(p[1]), p[2], {stod(p[3]), stod(p[4])}));
                } else if (p[0] == "ITEM" && n >= 5) {
                    Negocio* neg = s.buscarNegocio(stoi(p[1]));
                    if (neg) neg->agregarItemConId(stoi(p[2]), p[3], stod(p[4]));
                } else if (p[0] == "CLIENTE" && n >= 5) {
                    s.agregar(Cliente(stoi(p[1]), p[2], {stod(p[3]), stod(p[4])}));
                } else if (p[0] == "MENSAJERO" && n >= 8) {
                    s.agregar(Mensajero(stoi(p[1]), p[2], {stod(p[3]), stod(p[4])},
                                        {p[5], p[6]}, p[7] == "1"));
                }
            } catch (...) {
                cerr << "Linea invalida ignorada: " << linea << "\n";
            }
        }

        while (getline(fo, linea)) {
            int n = dividir(linea, '|', p, MAX_CAMPOS);
            if (n < 9 || p[0] != "ORDEN") continue;
            try {
                LineaOrden lineas[MAX_LINEAS];
                int nl = 0;
                string toks[MAX_CAMPOS];
                int nt = dividir(p[8], ';', toks, MAX_CAMPOS);
                for (int i = 0; i < nt && nl < MAX_LINEAS; ++i) {
                    string q[4];
                    if (dividir(toks[i], ':', q, 4) < 4) continue;
                    lineas[nl].itemId = stoi(q[0]);
                    lineas[nl].cantidad = stoi(q[1]);
                    lineas[nl].precio = stod(q[2]);
                    lineas[nl].nombre = q[3];
                    ++nl;
                }
                s.agregar(Orden(stoi(p[1]), stoi(p[2]), stoi(p[3]), stoi(p[4]), lineas, nl,
                                stod(p[5]), stod(p[6]), static_cast<EstadoOrden>(stoi(p[7]))));
            } catch (...) {
                cerr << "Orden invalida ignorada: " << linea << "\n";
            }
        }
        return true;
    }
};

static string leerLinea(const string& msg) {
    cout << msg;
    string s;
    if (!getline(cin, s)) { cout << "\n"; exit(0); }
    return s;
}
static int leerInt(const string& msg) {
    while (true) {
        string s = leerLinea(msg);
        try {
            size_t pos;
            int v = stoi(s, &pos);
            if (pos == s.size()) return v;
        } catch (...) {}
        cout << "  Valor invalido, intenta de nuevo.\n";
    }
}
static double leerDouble(const string& msg) {
    while (true) {
        string s = leerLinea(msg);
        try {
            size_t pos;
            double v = stod(s, &pos);
            if (pos == s.size()) return v;
        } catch (...) {}
        cout << "  Valor invalido, intenta de nuevo.\n";
    }
}
static Ubicacion leerUbicacion() {
    cout << "  (Ejemplo Puno: lat -15.8402, lon -70.0219)\n";
    Ubicacion u;
    u.lat = leerDouble("  Latitud : ");
    u.lon = leerDouble("  Longitud: ");
    return u;
}

