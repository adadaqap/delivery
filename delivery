using namespace std;

static vector<string> dividir(const string& s, char d) {
    vector<string> partes;
    string actual;
    stringstream ss(s);
    while (getline(ss, actual, d)) partes.push_back(actual);
    return partes;
}

static string limpiar(string s) {
    for (char& c : s)
        if (c == '|' || c == ';' || c == ':') c = ' ';
    return s;
}

struct Ubicacion {
    double lat = 0.0;
    double lon = 0.0;

    double distanciaKm(const Ubicacion& o) const {
        const double R = 6371.0;
        const double rad = M_PI / 180.0;
        double dLat = (o.lat - lat) * rad;
        double dLon = (o.lon - lon) * rad;
        double a = sin(dLat / 2) * sin(dLat / 2) +
                   cos(lat * rad) * cos(o.lat * rad) * sin(dLon / 2) * sin(dLon / 2);
        return 2 * R * atan2(sqrt(a), sqrt(1 - a));
    }
};

class Entidad {
protected:
    int id_;
    string nombre_;
    Ubicacion ubi_;

public:
    Entidad(int id, const string& nombre, Ubicacion ubi)
        : id_(id), nombre_(limpiar(nombre)), ubi_(ubi) {}
    virtual ~Entidad() = default;

    int id() const { return id_; }
    const string& nombre() const { return nombre_; }
    const Ubicacion& ubicacion() const { return ubi_; }

    virtual string tipo() const = 0;
    virtual string serializar() const = 0;
    virtual void mostrar() const {
        cout << "[" << tipo() << " #" << id_ << "] " << nombre_ << fixed << setprecision(5)
             << "  GPS(" << ubi_.lat << ", " << ubi_.lon << ")";
    }

protected:
    string base() const {
        ostringstream o;
        o << fixed << setprecision(6) << id_ << "|" << nombre_ << "|" << ubi_.lat << "|"
          << ubi_.lon;
        return o.str();
    }
};

struct ItemMenu {
    int id;
    string nombre;
    double precio;
};

class Negocio : public Entidad {
    vector<ItemMenu> menu_;

public:
    using Entidad::Entidad;

    string tipo() const override { return "NEGOCIO"; }

    void agregarItem(const string& nombre, double precio) {
        int nuevoId = 1;
        for (const auto& it : menu_) nuevoId = max(nuevoId, it.id + 1);
        menu_.push_back({nuevoId, limpiar(nombre), precio});
    }
    void agregarItemConId(int id, const string& nombre, double precio) {
        menu_.push_back({id, limpiar(nombre), precio});
    }
    const ItemMenu* buscarItem(int id) const {
        for (const auto& it : menu_)
            if (it.id == id) return &it;
        return nullptr;
    }
    const vector<ItemMenu>& menu() const { return menu_; }

    void mostrarMenu() const {
        cout << "--- Menu de " << nombre_ << " ---\n";
        if (menu_.empty()) cout << "(sin items)\n";
        for (const auto& it : menu_)
            cout << "  " << it.id << ") " << left << setw(25) << it.nombre << right << "S/ "
                 << fixed << setprecision(2) << it.precio << "\n";
    }

    string serializar() const override {
        ostringstream o;
        o << "NEGOCIO|" << base() << "\n";
        for (const auto& it : menu_)
            o << "ITEM|" << id_ << "|" << it.id << "|" << it.nombre << "|" << fixed
              << setprecision(2) << it.precio << "\n";
        return o.str();
    }
};

class Cliente : public Entidad {
public:
    using Entidad::Entidad;
    string tipo() const override { return "CLIENTE"; }
    string serializar() const override { return "CLIENTE|" + base() + "\n"; }
};

struct Vehiculo {
    string tipo;
    string placa;
};

class Mensajero : public Entidad {
    Vehiculo vehiculo_;
    bool disponible_;

public:
    Mensajero(int id, const string& nombre, Ubicacion u, Vehiculo v, bool disp = true)
        : Entidad(id, nombre, u), vehiculo_{limpiar(v.tipo), limpiar(v.placa)}, disponible_(disp) {}

    string tipo() const override { return "MENSAJERO"; }
    bool disponible() const { return disponible_; }
    void setDisponible(bool d) { disponible_ = d; }
    void setUbicacion(const Ubicacion& u) { ubi_ = u; }
    const Vehiculo& vehiculo() const { return vehiculo_; }

    void mostrar() const override {
        Entidad::mostrar();
        cout << "  " << vehiculo_.tipo << " [" << vehiculo_.placa << "]  "
             << (disponible_ ? "DISPONIBLE" : "OCUPADO");
    }
    string serializar() const override {
        return "MENSAJERO|" + base() + "|" + vehiculo_.tipo + "|" + vehiculo_.placa + "|" +
               (disponible_ ? "1" : "0") + "\n";
    }
};

class CalculadoraTarifa {
public:
    virtual ~CalculadoraTarifa() = default;
    virtual double calcular(double km) const = 0;
};

class TarifaPorKm : public CalculadoraTarifa {
    double base_, porKm_, minima_;

public:
    TarifaPorKm(double base = 3.0, double porKm = 1.5, double minima = 4.0)
        : base_(base), porKm_(porKm), minima_(minima) {}
    double calcular(double km) const override { return max(minima_, base_ + porKm_ * km); }
};

enum class EstadoOrden { Pendiente, Preparando, EnCamino, Entregado };

static string aTexto(EstadoOrden e) {
    switch (e) {
        case EstadoOrden::Pendiente:  return "Pendiente";
        case EstadoOrden::Preparando: return "Preparando";
        case EstadoOrden::EnCamino:   return "En camino";
        case EstadoOrden::Entregado:  return "Entregado";
    }
    return "?";
}

struct LineaOrden {
    int itemId;
    string nombre;
    int cantidad;
    double precio;
};

class Orden {
    int id_, clienteId_, negocioId_, mensajeroId_;
    vector<LineaOrden> lineas_;
    double distanciaKm_, tarifa_;
    EstadoOrden estado_;

public:
    Orden(int id, int cli, int neg, int men, vector<LineaOrden> lineas, double km, double tarifa,
          EstadoOrden est = EstadoOrden::Pendiente)
        : id_(id), clienteId_(cli), negocioId_(neg), mensajeroId_(men), lineas_(move(lineas)),
          distanciaKm_(km), tarifa_(tarifa), estado_(est) {}

    int id() const { return id_; }
    int clienteId() const { return clienteId_; }
    int negocioId() const { return negocioId_; }
    int mensajeroId() const { return mensajeroId_; }
    EstadoOrden estado() const { return estado_; }
    double distanciaKm() const { return distanciaKm_; }
    double tarifa() const { return tarifa_; }

    double subtotal() const {
        double s = 0;
        for (const auto& l : lineas_) s += l.cantidad * l.precio;
        return s;
    }
    double total() const { return subtotal() + tarifa_; }

    bool avanzar() {
        if (estado_ == EstadoOrden::Entregado) return false;
        estado_ = static_cast<EstadoOrden>(static_cast<int>(estado_) + 1);
        return true;
    }

    void mostrar() const {
        cout << "Orden #" << id_ << " | cliente " << clienteId_ << " | negocio " << negocioId_
             << " | mensajero " << mensajeroId_ << " | " << aTexto(estado_) << "\n";
        for (const auto& l : lineas_)
            cout << "    " << l.cantidad << " x " << l.nombre << " (S/ " << fixed
                 << setprecision(2) << l.precio << ")\n";
        cout << fixed << setprecision(2) << "    Distancia: " << distanciaKm_
             << " km | Subtotal: S/ " << subtotal() << " | Envio: S/ " << tarifa_
             << " | TOTAL: S/ " << total() << "\n";
    }

    string serializar() const {
        ostringstream o;
        o << "ORDEN|" << id_ << "|" << clienteId_ << "|" << negocioId_ << "|" << mensajeroId_
          << "|" << fixed << setprecision(4) << distanciaKm_ << "|" << setprecision(2)
          << tarifa_ << "|" << static_cast<int>(estado_) << "|";
        for (size_t i = 0; i < lineas_.size(); ++i) {
            const auto& l = lineas_[i];
            if (i) o << ";";
            o << l.itemId << ":" << l.cantidad << ":" << fixed << setprecision(2) << l.precio
              << ":" << l.nombre;
        }
        return o.str() + "\n";
    }
};

template <class T>
static int siguienteId(const vector<T>& v) {
    int m = 0;
    for (const auto& e : v) m = max(m, e.id());
    return m + 1;
}

template <class T>
static T* buscar(vector<T>& v, int id) {
    for (auto& e : v)
        if (e.id() == id) return &e;
    return nullptr;
}

class SistemaDelivery {
    vector<Negocio> negocios_;
    vector<Cliente> clientes_;
    vector<Mensajero> mensajeros_;
    vector<Orden> ordenes_;
    TarifaPorKm tarifa_;

public:
    Negocio& registrarNegocio(const string& n, Ubicacion u) {
        negocios_.emplace_back(siguienteId(negocios_), n, u);
        return negocios_.back();
    }
    Cliente& registrarCliente(const string& n, Ubicacion u) {
        clientes_.emplace_back(siguienteId(clientes_), n, u);
        return clientes_.back();
    }
    Mensajero& registrarMensajero(const string& n, Ubicacion u, Vehiculo v) {
        mensajeros_.emplace_back(siguienteId(mensajeros_), n, u, v);
        return mensajeros_.back();
    }

    void agregar(Negocio n) { negocios_.push_back(move(n)); }
    void agregar(Cliente c) { clientes_.push_back(move(c)); }
    void agregar(Mensajero m) { mensajeros_.push_back(move(m)); }
    void agregar(Orden o) { ordenes_.push_back(move(o)); }
    void limpiarTodo() {
        negocios_.clear(); clientes_.clear(); mensajeros_.clear(); ordenes_.clear();
    }

    vector<Negocio>& negocios() { return negocios_; }
    vector<Cliente>& clientes() { return clientes_; }
    vector<Mensajero>& mensajeros() { return mensajeros_; }
    vector<Orden>& ordenes() { return ordenes_; }
    const vector<Negocio>& negocios() const { return negocios_; }
    const vector<Cliente>& clientes() const { return clientes_; }
    const vector<Mensajero>& mensajeros() const { return mensajeros_; }
    const vector<Orden>& ordenes() const { return ordenes_; }

    Negocio* buscarNegocio(int id) { return buscar(negocios_, id); }
    Cliente* buscarCliente(int id) { return buscar(clientes_, id); }
    Mensajero* buscarMensajero(int id) { return buscar(mensajeros_, id); }
    Orden* buscarOrden(int id) { return buscar(ordenes_, id); }

    Mensajero* mensajeroMasCercano(const Ubicacion& destino) {
        Mensajero* mejor = nullptr;
        double mejorKm = numeric_limits<double>::max();
        for (auto& m : mensajeros_) {
            if (!m.disponible()) continue;
            double d = m.ubicacion().distanciaKm(destino);
            if (d < mejorKm) { mejorKm = d; mejor = &m; }
        }
        return mejor;
    }

    Orden* crearOrden(int clienteId, int negocioId, const vector<LineaOrden>& carrito,
                      string& error) {
        Cliente* c = buscarCliente(clienteId);
        Negocio* n = buscarNegocio(negocioId);
        if (!c) { error = "Cliente no existe."; return nullptr; }
        if (!n) { error = "Negocio no existe."; return nullptr; }
        if (carrito.empty()) { error = "El carrito esta vacio."; return nullptr; }

        Mensajero* m = mensajeroMasCercano(n->ubicacion());
        if (!m) { error = "No hay mensajeros disponibles."; return nullptr; }

        double km = n->ubicacion().distanciaKm(c->ubicacion());
        double tarifa = tarifa_.calcular(km);

        m->setDisponible(false);
        ordenes_.emplace_back(siguienteId(ordenes_), clienteId, negocioId, m->id(), carrito, km,
                              tarifa);
        return &ordenes_.back();
    }

    bool avanzarOrden(int id, string& msg) {
        Orden* o = buscarOrden(id);
        if (!o) { msg = "Orden no existe."; return false; }
        if (!o->avanzar()) { msg = "La orden ya fue entregada."; return false; }
        if (o->estado() == EstadoOrden::Entregado) {
            Mensajero* m = buscarMensajero(o->mensajeroId());
            Cliente* c = buscarCliente(o->clienteId());
            if (m) {
                if (c) m->setUbicacion(c->ubicacion());
                m->setDisponible(true);
            }
        }
        msg = "Orden #" + to_string(id) + " ahora esta: " + aTexto(o->estado());
        return true;
    }
};

class RepositorioArchivo {
    string archEntidades_, archOrdenes_;

public:
    RepositorioArchivo(string e = "entidades.txt", string o = "ordenes.txt")
        : archEntidades_(move(e)), archOrdenes_(move(o)) {}

    bool guardar(const SistemaDelivery& s) const {
        ofstream fe(archEntidades_);
        ofstream fo(archOrdenes_);
        if (!fe || !fo) return false;
        for (const auto& n : s.negocios()) fe << n.serializar();
        for (const auto& c : s.clientes()) fe << c.serializar();
        for (const auto& m : s.mensajeros()) fe << m.serializar();
        for (const auto& o : s.ordenes()) fo << o.serializar();
        return true;
    }

    bool leer(SistemaDelivery& s) const {
        ifstream fe(archEntidades_);
        ifstream fo(archOrdenes_);
        if (!fe && !fo) return false;
        s.limpiarTodo();

        string linea;
        while (getline(fe, linea)) {
            auto p = dividir(linea, '|');
            if (p.empty()) continue;
            try {
                if (p[0] == "NEGOCIO" && p.size() >= 5) {
                    s.agregar(Negocio(stoi(p[1]), p[2], {stod(p[3]), stod(p[4])}));
                } else if (p[0] == "ITEM" && p.size() >= 5) {
                    if (Negocio* n = s.buscarNegocio(stoi(p[1])))
                        n->agregarItemConId(stoi(p[2]), p[3], stod(p[4]));
                } else if (p[0] == "CLIENTE" && p.size() >= 5) {
                    s.agregar(Cliente(stoi(p[1]), p[2], {stod(p[3]), stod(p[4])}));
                } else if (p[0] == "MENSAJERO" && p.size() >= 8) {
                    s.agregar(Mensajero(stoi(p[1]), p[2], {stod(p[3]), stod(p[4])},
                                        {p[5], p[6]}, p[7] == "1"));
                }
            } catch (...) {
                cerr << "Linea invalida ignorada: " << linea << "\n";
            }
        }

        while (getline(fo, linea)) {
            auto p = dividir(linea, '|');
            if (p.size() < 9 || p[0] != "ORDEN") continue;
            try {
                vector<LineaOrden> lineas;
                for (const auto& tok : dividir(p[8], ';')) {
                    auto q = dividir(tok, ':');
                    if (q.size() < 4) continue;
                    lineas.push_back({stoi(q[0]), q[3], stoi(q[1]), stod(q[2])});
                }
                s.agregar(Orden(stoi(p[1]), stoi(p[2]), stoi(p[3]), stoi(p[4]), lineas,
                                stod(p[5]), stod(p[6]), static_cast<EstadoOrden>(stoi(p[7]))));
            } catch (...) {
                cerr << "Orden invalida ignorada: " << linea << "\n";
            }
        }
        return true;
    }
};

static string leerLinea(const string& msg) {
    cout << msg;
    string s;
    if (!getline(cin, s)) { cout << "\n"; exit(0); }
    return s;
}
static int leerInt(const string& msg) {
    while (true) {
        string s = leerLinea(msg);
        try {
            size_t pos;
            int v = stoi(s, &pos);
            if (pos == s.size()) return v;
        } catch (...) {}
        cout << "  Valor invalido, intenta de nuevo.\n";
    }
}
static double leerDouble(const string& msg) {
    while (true) {
        string s = leerLinea(msg);
        try {
            size_t pos;
            double v = stod(s, &pos);
            if (pos == s.size()) return v;
        } catch (...) {}
        cout << "  Valor invalido, intenta de nuevo.\n";
    }
}
static Ubicacion leerUbicacion() {
    cout << "  (Ejemplo Puno: lat -15.8402, lon -70.0219)\n";
    Ubicacion u;
    u.lat = leerDouble("  Latitud : ");
    u.lon = leerDouble("  Longitud: ");
    return u;
}

class App {
    SistemaDelivery sistema_;
    RepositorioArchivo repo_;

    void registrarNegocio() {
        string nombre = leerLinea("Nombre del negocio: ");
        Ubicacion u = leerUbicacion();
        Negocio& n = sistema_.registrarNegocio(nombre, u);
        cout << "Agrega items al menu (nombre vacio para terminar):\n";
        while (true) {
            string it = leerLinea("  Item: ");
            if (it.empty()) break;
            n.agregarItem(it, leerDouble("  Precio S/: "));
        }
        cout << "Negocio registrado con id " << n.id() << ".\n";
    }

    void registrarCliente() {
        string nombre = leerLinea("Nombre del cliente: ");
        Ubicacion u = leerUbicacion();
        cout << "Cliente registrado con id " << sistema_.registrarCliente(nombre, u).id() << ".\n";
    }

    void registrarMensajero() {
        string nombre = leerLinea("Nombre del mensajero: ");
        string tipo = leerLinea("Tipo de vehiculo (moto/bici/auto): ");
        string placa = leerLinea("Placa: ");
        Ubicacion u = leerUbicacion();
        cout << "Mensajero registrado con id "
             << sistema_.registrarMensajero(nombre, u, {tipo, placa}).id() << ".\n";
    }

    void listarEntidades() const {
        cout << "\n== NEGOCIOS ==\n";
        for (const auto& n : sistema_.negocios()) { n.mostrar(); cout << "\n"; }
        cout << "== CLIENTES ==\n";
        for (const auto& c : sistema_.clientes()) { c.mostrar(); cout << "\n"; }
        cout << "== MENSAJEROS ==\n";
        for (const auto& m : sistema_.mensajeros()) { m.mostrar(); cout << "\n"; }
    }

    void verMenu() {
        int id = leerInt("Id del negocio: ");
        if (Negocio* n = sistema_.buscarNegocio(id)) n->mostrarMenu();
        else cout << "Negocio no existe.\n";
    }

    void crearOrden() {
        int cid = leerInt("Id del cliente: ");
        int nid = leerInt("Id del negocio: ");
        Negocio* n = sistema_.buscarNegocio(nid);
        if (!n || !sistema_.buscarCliente(cid)) { cout << "Cliente o negocio no existe.\n"; return; }

        n->mostrarMenu();
        vector<LineaOrden> carrito;  // el "carrito"
        cout << "Agrega items al carrito (id 0 para terminar):\n";
        while (true) {
            int iid = leerInt("  Id del item: ");
            if (iid == 0) break;
            const ItemMenu* it = n->buscarItem(iid);
            if (!it) { cout << "  Item no existe.\n"; continue; }
            int cant = leerInt("  Cantidad: ");
            if (cant <= 0) { cout << "  Cantidad invalida.\n"; continue; }
            carrito.push_back({it->id, it->nombre, cant, it->precio});
        }

        string error;
        Orden* o = sistema_.crearOrden(cid, nid, carrito, error);
        if (!o) { cout << "No se pudo crear la orden: " << error << "\n"; return; }

        Mensajero* m = sistema_.buscarMensajero(o->mensajeroId());
        cout << "\nOrden creada. Mensajero asignado: " << m->nombre() << " (#" << m->id() << ")\n";
        o->mostrar();
    }

    void avanzarEstado() {
        string msg;
        sistema_.avanzarOrden(leerInt("Id de la orden: "), msg);
        cout << msg << "\n";
    }

    void listarOrdenes() const {
        if (sistema_.ordenes().empty()) cout << "No hay ordenes.\n";
        for (const auto& o : sistema_.ordenes()) o.mostrar();
    }

    void consultarDistancia() {
        Negocio* n = sistema_.buscarNegocio(leerInt("Id del negocio: "));
        Cliente* c = sistema_.buscarCliente(leerInt("Id del cliente: "));
        if (!n || !c) { cout << "Negocio o cliente no existe.\n"; return; }
        double km = n->ubicacion().distanciaKm(c->ubicacion());
        cout << fixed << setprecision(2) << "Distancia: " << km << " km | Tarifa: S/ "
             << TarifaPorKm().calcular(km) << "\n";
    }

public:
    void ejecutar() {
        if (repo_.leer(sistema_)) cout << "Datos cargados desde archivo.\n";
        while (true) {
            cout << "\n===== DELIVERY SIMULADO =====\n"
                    "1. Registrar negocio (con menu)\n"
                    "2. Registrar cliente\n"
                    "3. Registrar mensajero\n"
                    "4. Listar entidades\n"
                    "5. Ver menu de un negocio\n"
                    "6. Crear orden\n"
                    "7. Avanzar estado de una orden\n"
                    "8. Listar ordenes\n"
                    "9. Consultar distancia y tarifa negocio-cliente\n"
                    "10. Guardar en archivo\n"
                    "11. Leer desde archivo\n"
                    "0. Salir (guarda automaticamente)\n";
            switch (leerInt("Opcion: ")) {
                case 1: registrarNegocio(); break;
                case 2: registrarCliente(); break;
                case 3: registrarMensajero(); break;
                case 4: listarEntidades(); break;
                case 5: verMenu(); break;
                case 6: crearOrden(); break;
                case 7: avanzarEstado(); break;
                case 8: listarOrdenes(); break;
                case 9: consultarDistancia(); break;
                case 10: cout << (repo_.guardar(sistema_) ? "Guardado.\n" : "Error al guardar.\n"); break;
                case 11: cout << (repo_.leer(sistema_) ? "Datos leidos.\n" : "No hay archivos.\n"); break;
                case 0:
                    repo_.guardar(sistema_);
                    cout << "Datos guardados. Hasta luego.\n";
                    return;
                default: cout << "Opcion invalida.\n";
            }
        }
    }
};

int main() {
    App app;
    app.ejecutar();
    return 0;
}
